@model IEnumerable<MyProject.Application.DTOs.StaffDto>

@{
    ViewData["Title"] = "Staff Management";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-slate-800 fw-bold">Staff Management</h1>
            <p class="text-muted small mb-0">Search, register, and manage hospital staff members.</p>
        </div>
        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createStaffModal">
            <i class="fa-solid fa-user-plus"></i> New Staff Registration
        </button>
    </div>

    <!-- Advanced Search Panel -->
    <div class="modern-card" style="padding: 20px;">
        <h6 class="fw-bold text-slate-700 mb-3"><i class="fa-solid fa-sliders me-2"></i>Advanced Search</h6>
        <form method="get" asp-action="Index">
            <div class="search-card-filters">
                <div class="form-group-custom">
                    <label class="form-label-custom">Staff Name</label>
                    <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control-custom" placeholder="e.g. Alice Johnson" />
                </div>
                <div class="form-group-custom" style="flex: 0 0 200px;">
                    <label class="form-label-custom">Position / Role</label>
                    <select name="searchPosition" class="form-control-custom" style="padding: 9px 12px;">
                        <option value="All">All Positions</option>
                        @if (ViewBag.Positions is List<string> positions)
                        {
                            foreach (var pos in positions)
                            {
                                if (!string.IsNullOrEmpty(pos))
                                {
                                    <option value="@pos" selected="@(ViewBag.SearchPosition == pos)">@pos</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-custom" style="padding: 10px 18px;">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </button>
                    <a asp-action="Index" class="btn-secondary-custom" style="padding: 10px 18px;">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Staff List Table -->
    <div class="modern-card modern-table-card">
        <div class="modern-table-header">
            <h5 class="modern-table-title">Registered Staff (@Model.Count())</h5>
        </div>
        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 250px;">Staff Name / Username</th>
                        <th>Position</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Joined Date</th>
                        <th class="text-end" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fa-2x mb-3 text-secondary"></i>
                                <p class="mb-0">No staff matched the criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var initials = "ST";
                            if (!string.IsNullOrEmpty(item.FullName))
                            {
                                var parts = item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                if (parts.Length > 1)
                                {
                                    initials = (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
                                }
                                else if (parts.Length > 0)
                                {
                                    initials = parts[0][0].ToString().ToUpper();
                                }
                            }

                            var avatarClasses = new[] { "avatar-blue", "avatar-indigo", "avatar-purple", "avatar-pink", "avatar-emerald", "avatar-rose" };
                            var avatarClass = avatarClasses[Math.Abs(item.StaffId) % avatarClasses.Length];

                            // Escape for JS
                            var safeName = item.FullName.Replace("'", "\\'").Replace("\"", "&quot;");
                            var safePhone = (item.Phone ?? "").Replace("'", "\\'");
                            var safeEmail = (item.Email ?? "").Replace("'", "\\'");
                            var safePos = (item.Position ?? "").Replace("'", "\\'");

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle @avatarClass">@initials</div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-slate-800">@item.FullName</span>
                                            <span class="text-muted" style="font-size: 11px;">@@@item.Username</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="modern-badge badge-scheduled">@(item.Position ?? "Staff")</span>
                                </td>
                                <td>
                                    <span class="text-slate-700">@(item.Phone ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="text-slate-700">@(item.Email ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.CreatedAt.ToString("dd MMM yyyy")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <button type="button" class="table-action-icon" title="Edit Staff"
                                                onclick="openEditStaffModal(@item.StaffId, '@safeName', '@safePhone', '@safeEmail', '@safePos')">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <button type="button" class="table-action-icon danger-hover" title="Delete Staff"
                                                onclick="openDeleteStaffModal(@item.StaffId, '@safeName')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Staff Modal -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title"><i class="fa-solid fa-user-plus me-2"></i>Register New Staff</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Full Name</label>
                            <input type="text" name="FullName" class="form-control rounded-3" placeholder="e.g. Alice Johnson" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Username (for login)</label>
                            <input type="text" name="Username" class="form-control rounded-3" placeholder="e.g. alicej" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Password</label>
                            <input type="password" name="Password" class="form-control rounded-3" placeholder="Min 6 characters" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Phone Number</label>
                            <input type="text" name="Phone" class="form-control rounded-3" placeholder="e.g. 0912345678" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Email Address</label>
                            <input type="email" name="Email" class="form-control rounded-3" placeholder="e.g. alice@hospital.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Position / Role</label>
                            <select name="Position" class="form-select rounded-3" required>
                                <option value="Receptionist">Receptionist</option>
                                <option value="Nurse">Nurse</option>
                                <option value="Staff">General Staff</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fa-solid fa-user-plus me-1"></i> Register Staff
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Staff Modal -->
<div class="modal fade" id="editStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title"><i class="fa-solid fa-user-pen me-2"></i>Edit Staff Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editStaffForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Full Name</label>
                            <input type="text" name="FullName" id="editStaffFullName" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Phone Number</label>
                            <input type="text" name="Phone" id="editStaffPhone" class="form-control rounded-3" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Email Address</label>
                            <input type="email" name="Email" id="editStaffEmail" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Position / Role</label>
                            <select name="Position" id="editStaffPosition" class="form-select rounded-3" required>
                                <option value="Receptionist">Receptionist</option>
                                <option value="Nurse">Nurse</option>
                                <option value="Staff">General Staff</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4">
                        <i class="fa-solid fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="deleteStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title"><i class="fa-solid fa-trash-alt me-2"></i>Delete Staff</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="fa-solid fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                <p class="mb-1">Are you sure you want to delete:</p>
                <p class="fw-bold fs-6" id="deleteStaffName"></p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteStaffForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="fa-solid fa-trash-alt me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditStaffModal(id, name, phone, email, pos) {
            document.getElementById('editStaffFullName').value = name;
            document.getElementById('editStaffPhone').value = phone;
            document.getElementById('editStaffEmail').value = email;
            document.getElementById('editStaffPosition').value = pos;
            document.getElementById('editStaffForm').action = '/Staff/Edit/' + id;
            new bootstrap.Modal(document.getElementById('editStaffModal')).show();
        }

        function openDeleteStaffModal(id, name) {
            document.getElementById('deleteStaffName').textContent = name;
            document.getElementById('deleteStaffForm').action = '/Staff/Delete/' + id;
            new bootstrap.Modal(document.getElementById('deleteStaffModal')).show();
        }
    </script>
}
