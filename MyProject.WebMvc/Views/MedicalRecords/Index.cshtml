@model IEnumerable<MyProject.Application.DTOs.MedicalRecordDto>

@{
    ViewData["Title"] = "Medical Records";
    var allRecords = Model.ToList();
    var grouped = allRecords.Any()
        ? allRecords.GroupBy(r => r.PatientName).OrderBy(g => g.Key).ToList()
        : new List<IGrouping<string, MyProject.Application.DTOs.MedicalRecordDto>>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-file-medical text-primary me-2"></i>Medical Records</h1>
            <p class="text-muted small mb-0">Select a patient to view their medical records.</p>
        </div>
    </div>

    <!-- Patient Search -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-bold small text-muted">Search Patient</label>
                    <input type="text" name="search" class="form-control rounded-3"
                           placeholder="Enter patient name..."
                           value="@Context.Request.Query["search"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Filter by Status</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="">All Statuses</option>
                        <option value="Completed" selected="@(Context.Request.Query["status"] == "Completed")">Completed</option>
                        <option value="InProgress" selected="@(Context.Request.Query["status"] == "InProgress")">In Progress</option>
                        <option value="Pending" selected="@(Context.Request.Query["status"] == "Pending")">Pending</option>
                    </select>
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary rounded-3">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!allRecords.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5 text-muted">
                <i class="fa-solid fa-user-slash fa-3x mb-3 text-primary"></i>
                <p class="mb-0 fw-bold">No patients found.</p>
                <p class="small text-muted mb-0">Search with a different keyword or create appointments first.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var patientGroup in grouped)
            {
                var records = patientGroup
                    .OrderByDescending(r => r.AppointmentDate)
                    .ThenByDescending(r => r.AppointmentTime)
                    .ToList();
                var latestDate = records.First().AppointmentDate.ToString("yyyy-MM-dd");

                <div class="col-md-6 col-lg-4">
                    <a asp-action="PatientRecords" asp-route-patientName="@Uri.EscapeDataString(patientGroup.Key)" class="text-decoration-none">
                        <div class="card shadow-sm border-0 rounded-4 h-100 patient-card">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-success-subtle text-success rounded-circle p-3 me-3">
                                        <i class="fa-solid fa-user-injured fa-lg"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="m-0 fw-bold text-dark">@patientGroup.Key</h5>
                                        <span class="text-muted small">@records.Count record(s)</span>
                                    </div>
                                    <i class="fa-solid fa-chevron-right text-muted"></i>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa-solid fa-calendar me-1"></i>
                                    Latest: @latestDate
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .patient-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
    }
    .patient-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.1) !important;
    }
</style>
