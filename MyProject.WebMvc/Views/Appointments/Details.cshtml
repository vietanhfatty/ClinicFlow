@model MyProject.Application.DTOs.AppointmentDto

@{
    ViewData["Title"] = "Appointment Booking Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="fa-solid fa-circle-info me-2"></i>Appointment Details</h5>
                    <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-edit me-1"></i> Edit details
                    </a>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">APPOINTMENT ID</div>
                        <div class="col-sm-8 text-dark fw-bold">#@Model.AppointmentId</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">PATIENT NAME</div>
                        <div class="col-sm-8 text-dark fw-bold fs-5">@Model.PatientName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">ASSIGNED DOCTOR</div>
                        <div class="col-sm-8 text-dark">@Model.DoctorName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">DATE</div>
                        <div class="col-sm-8 text-dark">@Model.AppointmentDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">TIME</div>
                        <div class="col-sm-8 text-dark">@Model.AppointmentTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">STATUS</div>
                        <div class="col-sm-8">
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning-subtle text-warning border rounded-pill px-3 py-1">Pending</span>
                            }
                            else if (Model.Status == "Confirmed")
                            {
                                <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-1">Confirmed</span>
                            }
                            else if (Model.Status == "Completed")
                            {
                                <span class="badge bg-success-subtle text-success border rounded-pill px-3 py-1">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border rounded-pill px-3 py-1">Cancelled</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-sm-4 text-muted small fw-bold">REASON FOR BOOKING</div>
                        <div class="col-sm-8 text-dark text-wrap">@(string.IsNullOrEmpty(Model.Reason) ? "No details provided" : Model.Reason)</div>
                    </div>

                    <div class="d-flex justify-content-start mt-4 gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                        </a>
                        @if (User.IsInRole("Doctor"))
                        {
                            <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#followupModal">
                                <i class="fa-solid fa-calendar-plus me-1"></i> Schedule Follow-up
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (ViewBag.MedicalHistory != null)
            {
                var history = ViewBag.MedicalHistory as List<MyProject.Application.DTOs.MedicalRecordDto>;
                <div class="card shadow-sm border-0 rounded-4 mt-4 bg-white">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="m-0 fw-bold text-success"><i class="fa-solid fa-notes-medical me-2"></i>Lịch sử bệnh án / Patient Medical History</h5>
                    </div>
                    <div class="card-body p-4 pt-1">
                        @if (history == null || !history.Any())
                        {
                            <div class="text-center py-4 text-muted bg-light rounded-3">
                                <i class="fa-solid fa-folder-open fa-2x mb-2 text-secondary"></i>
                                <p class="mb-0 small fw-bold">Chưa có lịch sử bệnh án nào được ghi nhận cho bệnh nhân này.</p>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative ps-3" style="border-left: 2px solid #e9ecef; margin-left: 10px;">
                                @foreach (var record in history)
                                {
                                    <div class="position-relative mb-4">
                                        <!-- Timeline Bullet -->
                                        <span class="position-absolute rounded-circle bg-success" 
                                              style="width: 12px; height: 12px; left: -19px; top: 6px; border: 2px solid #fff; box-shadow: 0 0 0 2px #e9ecef;"></span>
                                        
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted small fw-bold">
                                                <i class="fa-solid fa-calendar-alt me-1"></i> @record.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                            </span>
                                            <span class="badge bg-secondary-subtle text-secondary">ID #@record.MedicalRecordId</span>
                                        </div>
                                        <div class="bg-light p-3 rounded-3 border-start border-success border-3">
                                            <div class="row">
                                                <div class="col-sm-6 mb-2 mb-sm-0">
                                                    <div class="text-muted small fw-semibold">CHẨN ĐOÁN (DIAGNOSIS)</div>
                                                    <div class="fw-bold text-dark">@record.Diagnosis</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="text-muted small fw-semibold">BÁC SĨ (DOCTOR)</div>
                                                    <div class="text-dark">@record.DoctorName</div>
                                                </div>
                                            </div>
                                            <div class="mt-2 pt-2 border-top border-2 border-white-50">
                                                <div class="text-muted small fw-semibold">TRIỆU CHỨNG (SYMPTOMS)</div>
                                                <div class="text-secondary small text-wrap">@(string.IsNullOrEmpty(record.Symptoms) ? "None" : record.Symptoms)</div>
                                            </div>
                                            <div class="mt-2">
                                                <div class="text-muted small fw-semibold">ĐIỀU TRỊ (TREATMENT PLAN)</div>
                                                <div class="text-secondary small text-wrap">@(string.IsNullOrEmpty(record.Treatment) ? "None" : record.Treatment)</div>
                                            </div>
                                            @if (record.Prescriptions != null && record.Prescriptions.Any())
                                            {
                                                <div class="mt-2">
                                                    <div class="text-muted small fw-semibold">THUỐC (PRESCRIPTION)</div>
                                                    <div class="text-dark small">
                                                        @string.Join(", ", record.Prescriptions.Select(p => $"{p.MedicineName} (Qty: {p.Quantity})"))
                                                    </div>
                                                </div>
                                            }
                                            <div class="text-end mt-2">
                                                <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@record.MedicalRecordId" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fs-7">
                                                    <i class="fa-solid fa-folder-open me-1"></i> Xem chi tiết / Open File
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (User.IsInRole("Doctor"))
{
    <!-- Follow-up Booking Modal -->
    <div class="modal fade" id="followupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title"><i class="fa-solid fa-clock me-2"></i>Schedule Follow-up Appointment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="ScheduleFollowup" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="patientId" value="@Model.PatientId" />
                    <div class="modal-body p-4">
                        <div class="alert alert-info rounded-3 small">
                            <i class="fa-solid fa-circle-info me-2"></i>You are scheduling a follow-up appointment for patient: <strong>@Model.PatientName</strong>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Select Appointment Date & Time</label>
                            <input type="datetime-local" name="appointmentDate" class="form-control rounded-3" required 
                                   value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-ddT09:00")" />
                            <small class="text-muted">Tip: Follow-up is usually recommended in 14 days.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Follow-up Reason / Notes</label>
                            <textarea name="reason" class="form-control rounded-3" rows="3" placeholder="Enter specific instructions or reason for follow-up..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="fa-solid fa-calendar-check me-1"></i> Confirm Follow-up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
