@model MyProject.Application.DTOs.UpdateAppointmentRequest

@{
    ViewData["Title"] = "Chỉnh sửa lịch hẹn";
}

<partial name="~/Views/Shared/_AppointmentStyles.cshtml" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header appt-card-header">
                    <h5 class="m-0 fw-bold" style="color: var(--appt-accent);">
                        <i class="fa-solid fa-edit me-2"></i>Chỉnh sửa lịch hẹn
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div asp-validation-summary="All" class="text-danger small"></div>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PatientId" class="form-label appt-label">Chọn bệnh nhân</label>
                                <select asp-for="PatientId" class="form-select rounded-3" required>
                                    @if (ViewBag.Patients != null)
                                    {
                                        @foreach (var pat in ViewBag.Patients)
                                        {
                                            <option value="@pat.PatientId" selected="@(Model.PatientId == pat.PatientId)">@pat.FullName (@(pat.Phone ?? "N/A"))</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DoctorId" class="form-label appt-label">Chọn bác sĩ</label>
                                <select asp-for="DoctorId" class="form-select rounded-3" required>
                                    @if (ViewBag.Doctors != null)
                                    {
                                        @foreach (var doc in ViewBag.Doctors)
                                        {
                                            <option value="@doc.DoctorId" selected="@(Model.DoctorId == doc.DoctorId)">@doc.FullName (@(string.IsNullOrEmpty(doc.Specialization) ? "Khám tổng quát" : doc.Specialization))</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="AppointmentDate" class="form-label appt-label">Ngày hẹn khám</label>
                                <input asp-for="AppointmentDate" type="date" class="form-control rounded-3" required value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AppointmentTime" class="form-label appt-label">Giờ hẹn khám</label>
                                <input asp-for="AppointmentTime" type="time" class="form-control rounded-3" required value="@Model.AppointmentTime.ToString(@"hh\:mm")" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Status" class="form-label appt-label">Trạng thái</label>
                                <select asp-for="Status" class="form-select rounded-3">
                                    <option value="Pending" selected="@(Model.Status == "Pending")">Chờ xác nhận</option>
                                    <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Đã xác nhận</option>
                                    <option value="Completed" selected="@(Model.Status == "Completed")">Hoàn thành</option>
                                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label appt-label">Lý do khám</label>
                            <textarea asp-for="Reason" rows="3" class="form-control rounded-3">@Model.Reason</textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                <i class="fa-solid fa-check me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
