@model IEnumerable<MyProject.Application.DTOs.AppointmentDto>
@using MyProject.Application.DTOs

@{
    ViewData["Title"] = "Hàng chờ của tôi";
    int rowCount = 1;
    var lateAppointments = ViewBag.LateAppointments as IEnumerable<AppointmentDto> ?? Enumerable.Empty<AppointmentDto>();
}

<partial name="~/Views/Shared/_AppointmentStyles.cshtml" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-people-queue text-success me-2"></i>Hàng chờ của tôi
            </h3>
            <p class="text-muted small mb-0">Danh sách bệnh nhân chờ khám hôm nay của BS: <strong>@ViewBag.DoctorName</strong></p>
        </div>
    </div>

    @if (lateAppointments.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 mb-4 border-start border-4 border-warning">
            <div class="card-header bg-warning-subtle py-3">
                <h6 class="m-0 fw-bold text-warning">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Bệnh nhân trễ hẹn (chưa check-in) — @lateAppointments.Count()
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Bệnh nhân</th>
                                <th>Giờ hẹn</th>
                                <th>Lý do</th>
                                <th class="text-end pe-4">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var late in lateAppointments)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@late.PatientName</td>
                                    <td><span class="badge bg-warning-subtle text-warning border rounded-pill px-2">@late.AppointmentTime.ToString(@"hh\:mm")</span></td>
                                    <td>@(string.IsNullOrEmpty(late.Reason) ? "Khám tổng quát" : late.Reason)</td>
                                    <td class="text-end pe-4">
                                        <form asp-action="CheckIn" asp-route-id="@late.AppointmentId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                <i class="fa-solid fa-clipboard-check me-1"></i> Check-in khi đến
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header appt-card-header">
            <h6 class="m-0 fw-bold">Bệnh nhân đang chờ (@Model.Count())</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-appointment">
                    <thead>
                        <tr>
                            <th class="ps-4">STT</th>
                            <th>Bệnh nhân</th>
                            <th>Giờ hẹn</th>
                            <th>Trạng thái</th>
                            <th>Lý do khám</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-mug-hot fa-3x mb-3 text-success"></i>
                                    <p class="mb-0 fw-bold">Không có bệnh nhân nào trong hàng chờ!</p>
                                    <p class="small text-muted mb-0">Tất cả bệnh nhân đã được khám hoặc chưa ai check-in hôm nay.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">
                                    @(rowCount++)
                                </td>
                                <td class="fw-bold text-dark">@item.PatientName</td>
                                <td>
                                    @if (item.IsWalkIn)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">
                                            <i class="fa-solid fa-person-walking me-1"></i> Khám trực tiếp
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@item.AppointmentTime.ToString(@"hh\:mm")</span>
                                    }
                                    @if (item.CheckInTime.HasValue)
                                    {
                                        <div class="text-muted small"><i class="fa-solid fa-clock me-1"></i>Đến: @item.CheckInTime.Value.ToString(@"HH\:mm")</div>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge badge-confirmed rounded-pill px-2">Đã xác nhận</span>
                                    }
                                    else if (item.Status == "InProgress")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2">Đang khám</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending rounded-pill px-2">@item.Status</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(item.Reason) ? "Khám tổng quát" : item.Reason)</td>
                                <td class="text-end pe-4">
                                    @if (item.Status == "Confirmed" || item.Status == "InProgress")
                                    {
                                        <a asp-action="Examination" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="fa-solid fa-play me-1"></i> @(item.Status == "InProgress" ? "Tiếp tục khám" : "Bắt đầu khám")
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="fa-solid fa-address-book me-1"></i> Hồ sơ
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
