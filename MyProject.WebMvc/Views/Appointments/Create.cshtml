@model MyProject.Application.DTOs.CreateAppointmentRequest

@{
    ViewData["Title"] = "Đặt lịch khám";
}

<partial name="~/Views/Shared/_AppointmentStyles.cshtml" />

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="fw-bold m-0 text-dark">
                        <i class="fa-solid fa-calendar-plus text-success me-2"></i>Đặt lịch khám
                    </h3>
                    <p class="text-muted m-0 small">Hướng dẫn tạo lịch hẹn khám bệnh cho bệnh nhân.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            <form asp-action="Create" method="post" id="appointmentForm">
                @Html.AntiForgeryToken()

                <!-- STEP 1: PATIENT -->
                <div class="card wizard-step-card">
                    <div class="card-header appt-card-header py-3 d-flex align-items-center">
                        <span class="step-number">1</span>
                        <h5 class="fw-bold m-0" style="color: var(--appt-accent);">Thông tin bệnh nhân</h5>
                    </div>
                    <div class="card-body px-4 pb-4 pt-2">
                        <div class="mb-3">
                            <label class="form-label appt-label">Tìm kiếm bệnh nhân (Tên hoặc SĐT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                </span>
                                <input type="text" id="patientSearchInput" class="form-control bg-light border-start-0" 
                                       placeholder="Nhập số điện thoại hoặc tên bệnh nhân..." autocomplete="off" />
                            </div>
                            <div id="searchResults" class="list-group shadow-sm mt-2 d-none" 
                                 style="max-height: 250px; overflow-y: auto; z-index: 1000; position: relative;"></div>
                        </div>

                        <div id="selectedPatientContainer" class="d-none mb-3">
                            <div class="patient-selected-badge d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fa-solid fa-circle-check me-2"></i>
                                    <span class="fw-bold" id="selectedPatientName">Chưa chọn bệnh nhân</span>
                                    <span class="ms-2 text-muted small" id="selectedPatientPhone"></span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle" id="clearPatientBtn">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                        </div>

                        <input type="hidden" asp-for="PatientId" id="hiddenPatientId" required />
                        <span asp-validation-for="PatientId" class="text-danger small d-block mb-3"></span>

                        <div class="text-center my-3">
                            <span class="text-muted small">HOẶC</span>
                        </div>

                        <div class="text-center">
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-4" id="toggleNewPatientBtn">
                                <i class="fa-solid fa-user-plus me-1"></i> Đăng ký bệnh nhân mới
                            </button>
                        </div>

                        <!-- Inline New Patient Form -->
                        <div id="newPatientFormContainer" class="d-none mt-4 p-4 border rounded-4 bg-light">
                            <h6 class="fw-bold mb-3 text-secondary">
                                <i class="fa-solid fa-address-card me-2"></i>Đăng ký bệnh nhân mới
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Họ và tên *</label>
                                    <input type="text" id="newPatName" class="form-control form-control-sm rounded-3" placeholder="VD: Nguyễn Văn A" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Số điện thoại *</label>
                                    <input type="text" id="newPatPhone" class="form-control form-control-sm rounded-3" placeholder="VD: 0901234567" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Ngày sinh</label>
                                    <input type="date" id="newPatDob" class="form-control form-control-sm rounded-3" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Giới tính</label>
                                    <select id="newPatGender" class="form-select form-select-sm rounded-3">
                                        <option value="Male">Nam</option>
                                        <option value="Female">Nữ</option>
                                        <option value="Other">Khác</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Nhóm máu</label>
                                    <select id="newPatBlood" class="form-select form-select-sm rounded-3">
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                        <option value="Unknown" selected>Chưa xác định</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Địa chỉ</label>
                                    <input type="text" id="newPatAddress" class="form-control form-control-sm rounded-3" placeholder="VD: 123 Đường ABC, Quận 1, TP.HCM" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Người liên hệ khẩn cấp</label>
                                    <input type="text" id="newPatEmergencyName" class="form-control form-control-sm rounded-3" placeholder="VD: Trần Thị B" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">SĐT liên hệ khẩn cấp</label>
                                    <input type="text" id="newPatEmergencyPhone" class="form-control form-control-sm rounded-3" placeholder="VD: 0909876543" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-3">
                                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3 me-2" id="cancelNewPatientBtn">Hủy</button>
                                <button type="button" class="btn btn-success btn-sm rounded-pill px-4" id="submitNewPatientBtn">
                                    <i class="fa-solid fa-check me-1"></i> Lưu & Chọn
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: DOCTOR & SPECIALIZATION -->
                <div class="card wizard-step-card">
                    <div class="card-header appt-card-header py-3 d-flex align-items-center">
                        <span class="step-number">2</span>
                        <h5 class="fw-bold m-0" style="color: var(--appt-accent);">Khoa & Bác sĩ</h5>
                    </div>
                    <div class="card-body px-4 pb-4 pt-2">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label appt-label">Chuyên khoa</label>
                                <select id="specializationSelect" class="form-select rounded-3">
                                    <option value="All">-- Tất cả khoa --</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DoctorId" class="form-label appt-label">Chọn bác sĩ</label>
                                <select asp-for="DoctorId" id="doctorSelect" class="form-select rounded-3" required>
                                    <option value="">-- Chọn bác sĩ --</option>
                                    @if (ViewBag.Doctors != null)
                                    {
                                        @foreach (var doc in ViewBag.Doctors)
                                        {
                                            <option value="@doc.DoctorId" data-spec="@doc.Specialization">@doc.FullName (@doc.Specialization)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 3: DATE & TIME -->
                <div class="card wizard-step-card">
                    <div class="card-header appt-card-header py-3 d-flex align-items-center">
                        <span class="step-number">3</span>
                        <h5 class="fw-bold m-0" style="color: var(--appt-accent);">Lịch hẹn</h5>
                    </div>
                    <div class="card-body px-4 pb-4 pt-2">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AppointmentDate" class="form-label appt-label">Ngày khám</label>
                                <input asp-for="AppointmentDate" type="date" id="appointmentDatePicker" class="form-control rounded-3" 
                                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="AppointmentTime" class="form-label appt-label">Giờ khám</label>
                                <input asp-for="AppointmentTime" type="time" id="appointmentTimePicker" class="form-control rounded-3" required />
                                <span asp-validation-for="AppointmentTime" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 4: REASON & CONFIRMATION -->
                <div class="card wizard-step-card">
                    <div class="card-header appt-card-header py-3 d-flex align-items-center">
                        <span class="step-number">4</span>
                        <h5 class="fw-bold m-0" style="color: var(--appt-accent);">Lý do khám</h5>
                    </div>
                    <div class="card-body px-4 pb-4 pt-2">
                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label appt-label">Triệu chứng / Lý do khám</label>
                            <textarea asp-for="Reason" class="form-control rounded-3" rows="3" 
                                      placeholder="Mô tả chi tiết triệu chứng hoặc lý do đặt lịch khám..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <input type="hidden" name="Status" value="Pending" />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm" id="bookBtn">
                                <i class="fa-solid fa-check me-2"></i> Đặt lịch khám
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const patients = [
            @if (ViewBag.Patients != null)
            {
                @foreach (var pat in ViewBag.Patients)
                {
                    <text>{ id: @pat.PatientId, name: "@Html.Raw(pat.FullName)", phone: "@Html.Raw(pat.Phone ?? "")" },</text>
                }
            }
        ];

        $(document).ready(function () {
            // Populate specializations list dynamically from doctor options
            const specs = new Set();
            $('#doctorSelect option').each(function () {
                const spec = $(this).data('spec');
                if (spec) specs.add(spec);
            });
            specs.forEach(s => {
                $('#specializationSelect').append(`<option value="${s}">${s}</option>`);
            });

            // Patient dynamic search
            $('#patientSearchInput').on('input', function () {
                const query = $(this).val().toLowerCase().trim();
                const $results = $('#searchResults');

                if (query.length < 1) {
                    $results.addClass('d-none').html('');
                    return;
                }

                const matches = patients.filter(p => 
                    p.name.toLowerCase().includes(query) || 
                    p.phone.includes(query)
                );

                if (matches.length === 0) {
                    $results.removeClass('d-none').html('<div class="list-group-item text-muted text-center py-3">Không tìm thấy bệnh nhân phù hợp.</div>');
                    return;
                }

                let html = '';
                matches.forEach(p => {
                    html += `
                        <div class="list-group-item search-result-item" data-id="${p.id}" data-name="${p.name}" data-phone="${p.phone}">
                            <div class="fw-bold">${p.name}</div>
                            <div class="text-muted small"><i class="fa-solid fa-phone me-1"></i> ${p.phone || 'N/A'}</div>
                        </div>
                    `;
                });
                $results.removeClass('d-none').html(html);
            });

            // Patient Selection
            $(document).on('click', '.search-result-item', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                const phone = $(this).data('phone');
                selectPatient(id, name, phone);
            });

            function selectPatient(id, name, phone) {
                $('#hiddenPatientId').val(id);
                $('#selectedPatientName').text(name);
                $('#selectedPatientPhone').text(phone ? `(SĐT: ${phone})` : '');
                
                $('#selectedPatientContainer').removeClass('d-none');
                $('#searchResults').addClass('d-none').html('');
                $('#patientSearchInput').val('').prop('disabled', true);
                $('#newPatientFormContainer').addClass('d-none');
            }

            // Clear selected patient
            $('#clearPatientBtn').on('click', function () {
                $('#hiddenPatientId').val('');
                $('#patientSearchInput').prop('disabled', false).val('').focus();
                $('#selectedPatientContainer').addClass('d-none');
            });

            // Inline register form toggle
            $('#toggleNewPatientBtn').on('click', function () {
                $('#newPatientFormContainer').removeClass('d-none');
                $('#clearPatientBtn').click();
                $('#newPatName').focus();
            });

            $('#cancelNewPatientBtn').on('click', function () {
                $('#newPatientFormContainer').addClass('d-none');
            });

            // AJAX inline registration
            $('#submitNewPatientBtn').on('click', function () {
                const name = $('#newPatName').val().trim();
                const phone = $('#newPatPhone').val().trim();
                const dob = $('#newPatDob').val();
                const gender = $('#newPatGender').val();
                const blood = $('#newPatBlood').val();
                const address = $('#newPatAddress').val().trim();
                const emergencyName = $('#newPatEmergencyName').val().trim();
                const emergencyPhone = $('#newPatEmergencyPhone').val().trim();

                if (!name || !phone) {
                    alert('Họ tên và số điện thoại là bắt buộc.');
                    return;
                }

                const postData = {
                    FullName: name,
                    Username: phone,
                    Password: "Password123",
                    Phone: phone,
                    DateOfBirth: dob ? dob : null,
                    Gender: gender,
                    BloodType: blood,
                    Address: address,
                    EmergencyContactName: emergencyName,
                    EmergencyContactPhone: emergencyPhone
                };

                $.ajax({
                    url: '/Patients/CreateApi',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(postData),
                    success: function (patient) {
                        patients.push({ id: patient.patientId, name: patient.fullName, phone: patient.phone });
                        selectPatient(patient.patientId, patient.fullName, patient.phone);
                        $('#newPatientFormContainer').addClass('d-none');
                        $('#newPatName, #newPatPhone, #newPatDob, #newPatAddress, #newPatEmergencyName, #newPatEmergencyPhone').val('');
                        alert('Đăng ký bệnh nhân thành công!');
                    },
                    error: function (xhr) {
                        const err = xhr.responseJSON ? xhr.responseJSON.message : 'Đăng ký thất bại.';
                        alert('Lỗi: ' + err);
                    }
                });
            });

            // Filter Doctors by Specialization
            $('#specializationSelect').on('change', function () {
                const spec = $(this).val();
                $('#doctorSelect').val('');

                if (spec === 'All') {
                    $('#doctorSelect option').show();
                } else {
                    $('#doctorSelect option').each(function () {
                        if ($(this).val() === "" || $(this).data('spec') === spec) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }
            });

            // Form validation
            $('#appointmentForm').on('submit', function (e) {
                if (!$('#hiddenPatientId').val() || $('#hiddenPatientId').val() === '0') {
                    e.preventDefault();
                    alert('Vui lòng chọn bệnh nhân trước.');
                }
            });
        });
    </script>
}
