@model IEnumerable<MyProject.Application.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "Lịch khám của tôi";
    var doctorName = ViewBag.DoctorName as string ?? "Bác sĩ";
}

<partial name="~/Views/Shared/_AppointmentStyles.cshtml" />

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-calendar-alt text-success me-2"></i>Lịch khám của tôi
            </h3>
            <p class="text-muted small mb-0">Tổng quan các lịch hẹn được phân công cho BS. @doctorName</p>
        </div>
        <div>
            <a asp-action="Queue" class="btn btn-success shadow-sm rounded-pill px-4">
                <i class="fa-solid fa-people-queue me-1"></i> Hàng chờ của tôi
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 filter-bar">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="patientSearchInput" class="form-label appt-label">Tìm bệnh nhân</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa-solid fa-user text-muted"></i>
                        </span>
                        <input type="text" id="patientSearchInput" class="form-control border-start-0" 
                               placeholder="Nhập tên bệnh nhân..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="dateFilterInput" class="form-label appt-label">Lọc theo ngày</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa-solid fa-calendar text-muted"></i>
                        </span>
                        <input type="date" id="dateFilterInput" class="form-control border-start-0" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label appt-label d-block">Lọc nhanh theo ngày</label>
                    <div class="btn-group w-100" role="group">
                        <button type="button" id="btnFilterAll" class="btn btn-outline-primary quick-filter-btn">Tất cả</button>
                        <button type="button" id="btnFilterToday" class="btn btn-outline-primary quick-filter-btn">Hôm nay</button>
                        <button type="button" id="btnFilterTomorrow" class="btn btn-outline-primary quick-filter-btn">Ngày mai</button>
                        <button type="button" id="btnFilterThisWeek" class="btn btn-outline-primary quick-filter-btn">Tuần này</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointments Table -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header appt-card-header">
            <h6 class="m-0 fw-bold">Danh sách lịch hẹn (@Model.Count() bản ghi)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-appointment" id="appointmentTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Bệnh nhân</th>
                            <th>Ngày</th>
                            <th>Giờ</th>
                            <th>Trạng thái</th>
                            <th>Lý do</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="appt-row" data-date="@item.AppointmentDate.ToString("yyyy-MM-dd")">
                                <td class="ps-4 fw-bold text-dark appt-patient">@item.PatientName</td>
                                <td>@item.AppointmentDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.AppointmentTime.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge badge-pending rounded-pill px-2">Chờ xác nhận</span>
                                    }
                                    else if (item.Status == "Confirmed")
                                    {
                                        <span class="badge badge-confirmed rounded-pill px-2">Đã xác nhận</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge badge-completed rounded-pill px-2">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-cancelled rounded-pill px-2">Đã hủy</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(item.Reason) ? "-" : item.Reason)
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-action="Confirm" asp-route-id="@item.AppointmentId" method="post" class="d-inline-block me-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                <i class="fa-solid fa-clipboard-check me-1"></i> Xác nhận
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="fa-solid fa-info-circle me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const patientInput = document.getElementById('patientSearchInput');
        const dateInput = document.getElementById('dateFilterInput');
        const btnAll = document.getElementById('btnFilterAll');
        const btnToday = document.getElementById('btnFilterToday');
        const btnTomorrow = document.getElementById('btnFilterTomorrow');
        const btnThisWeek = document.getElementById('btnFilterThisWeek');

        let activeDateMode = 'today';

        function getTodayDateString() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function getTomorrowDateString() {
            const now = new Date();
            now.setDate(now.getDate() + 1);
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Initialize default filter to Today
        dateInput.value = getTodayDateString();
        updateQuickButtonStyles();
        applyFilters();

        function updateQuickButtonStyles() {
            btnAll.classList.toggle('btn-primary', activeDateMode === 'all');
            btnAll.classList.toggle('btn-outline-primary', activeDateMode !== 'all');

            btnToday.classList.toggle('btn-primary', activeDateMode === 'today');
            btnToday.classList.toggle('btn-outline-primary', activeDateMode !== 'today');

            btnTomorrow.classList.toggle('btn-primary', activeDateMode === 'tomorrow');
            btnTomorrow.classList.toggle('btn-outline-primary', activeDateMode !== 'tomorrow');

            btnThisWeek.classList.toggle('btn-primary', activeDateMode === 'thisweek');
            btnThisWeek.classList.toggle('btn-outline-primary', activeDateMode !== 'thisweek');
        }

        function applyFilters() {
            const searchVal = patientInput.value.toLowerCase().trim();
            const dateVal = dateInput.value;

            let weekStart = null;
            let weekEnd = null;
            if (activeDateMode === 'thisweek') {
                const now = new Date();
                const day = now.getDay();
                const diffToMonday = now.getDate() - day + (day === 0 ? -6 : 1);
                weekStart = new Date(now.setDate(diffToMonday));
                weekStart.setHours(0,0,0,0);
                
                weekEnd = new Date(weekStart);
                weekEnd.setDate(weekStart.getDate() + 6);
                weekEnd.setHours(23,59,59,999);
            }

            document.querySelectorAll('.appt-row').forEach(function(row) {
                const patientName = row.querySelector('.appt-patient').textContent.toLowerCase();
                const matchesPatient = patientName.includes(searchVal);

                const rowDateStr = row.getAttribute('data-date');
                let matchesDate = false;

                if (activeDateMode === 'all') {
                    matchesDate = true;
                } else if (activeDateMode === 'thisweek') {
                    const rowDate = new Date(rowDateStr);
                    rowDate.setHours(0,0,0,0);
                    matchesDate = rowDate >= weekStart && rowDate <= weekEnd;
                } else if (dateVal) {
                    matchesDate = rowDateStr === dateVal;
                } else {
                    matchesDate = true;
                }

                if (matchesPatient && matchesDate) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        patientInput.addEventListener('keyup', applyFilters);
        
        dateInput.addEventListener('change', function() {
            activeDateMode = 'custom';
            updateQuickButtonStyles();
            applyFilters();
        });

        btnAll.addEventListener('click', function() {
            activeDateMode = 'all';
            dateInput.value = '';
            updateQuickButtonStyles();
            applyFilters();
        });

        btnToday.addEventListener('click', function() {
            activeDateMode = 'today';
            dateInput.value = getTodayDateString();
            updateQuickButtonStyles();
            applyFilters();
        });

        btnTomorrow.addEventListener('click', function() {
            activeDateMode = 'tomorrow';
            dateInput.value = getTomorrowDateString();
            updateQuickButtonStyles();
            applyFilters();
        });

        btnThisWeek.addEventListener('click', function() {
            activeDateMode = 'thisweek';
            dateInput.value = '';
            updateQuickButtonStyles();
            applyFilters();
        });
    </script>
}
