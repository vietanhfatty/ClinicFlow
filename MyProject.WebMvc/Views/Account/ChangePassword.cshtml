@model MyProject.Application.DTOs.ChangePasswordRequest

@{
    ViewData["Title"] = "Change Password";
}

<div class="container mt-4">
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <h3 class="fw-bold text-dark mb-2"><i class="fa-solid fa-key text-info me-2"></i>Change Password</h3>
                <p class="text-muted small border-bottom pb-3 mb-4">Update the password used to sign in to your account.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-4" role="alert">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold text-muted small">Current Password*</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="CurrentPassword" type="password" class="form-control border-start-0 rounded-end-3" required />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold text-muted small">New Password*</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control border-start-0 rounded-end-3" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold text-muted small">Confirm New Password*</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 rounded-end-3" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-info rounded-pill py-2 fw-bold text-white">
                            Update Password <i class="fa-solid fa-check ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
