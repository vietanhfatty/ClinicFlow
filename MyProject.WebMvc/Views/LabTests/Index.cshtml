@model List<MyProject.Application.DTOs.AppointmentLabTestDto>

@{
    ViewData["Title"] = "Xét nghiệm / Lab Tests";
    string statusFilter = ViewBag.StatusFilter ?? "Pending";
    string? search = ViewBag.Search;
    int? serviceFilter = ViewBag.ServiceFilter;
    string dateFilter = ViewBag.DateFilter ?? "Today";
    var services = ViewBag.Services as List<MyProject.Application.DTOs.LabTestServiceDto> ?? new List<MyProject.Application.DTOs.LabTestServiceDto>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-flask-vial me-2 text-info"></i>Danh sách xét nghiệm</h3>
            <p class="text-muted small mb-0">Nhập kết quả cho các xét nghiệm đã được bác sĩ chỉ định.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <div class="btn-group" role="group">
                        <a asp-action="Index" asp-route-statusFilter="Pending" asp-route-serviceFilter="@serviceFilter" asp-route-search="@search" asp-route-dateFilter="@dateFilter"
                           class="btn btn-sm rounded-pill px-3 @(statusFilter == "Pending" ? "btn-warning" : "btn-outline-warning")">
                            <i class="fa-solid fa-hourglass-half me-1"></i> Chờ xử lý
                        </a>
                        <a asp-action="Index" asp-route-statusFilter="Completed" asp-route-serviceFilter="@serviceFilter" asp-route-search="@search" asp-route-dateFilter="@dateFilter"
                           class="btn btn-sm rounded-pill px-3 ms-2 @(statusFilter == "Completed" ? "btn-success" : "btn-outline-success")">
                            <i class="fa-solid fa-circle-check me-1"></i> Đã hoàn thành
                        </a>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="btn-group" role="group">
                        <a asp-action="Index" asp-route-statusFilter="@statusFilter" asp-route-serviceFilter="@serviceFilter" asp-route-search="@search" asp-route-dateFilter="Today"
                           class="btn btn-sm rounded-pill px-3 @(dateFilter == "Today" ? "btn-primary" : "btn-outline-primary")">
                            <i class="fa-solid fa-calendar-day me-1"></i> Hôm nay
                        </a>
                        <a asp-action="Index" asp-route-statusFilter="@statusFilter" asp-route-serviceFilter="@serviceFilter" asp-route-search="@search" asp-route-dateFilter="All"
                           class="btn btn-sm rounded-pill px-3 ms-2 @(dateFilter == "All" ? "btn-primary" : "btn-outline-primary")">
                            <i class="fa-solid fa-calendar-days me-1"></i> Tất cả
                        </a>
                    </div>
                </div>
                <div class="col-auto">
                    <input type="hidden" name="statusFilter" value="@statusFilter" />
                    <input type="hidden" name="dateFilter" value="@dateFilter" />
                    <select name="serviceFilter" class="form-select rounded-pill" style="min-width: 260px;" onchange="this.form.submit()">
                        <option value="">Tất cả loại xét nghiệm</option>
                        @foreach (var svc in services)
                        {
                            <option value="@svc.LabTestServiceId" selected="@(serviceFilter == svc.LabTestServiceId)">@svc.ServiceName</option>
                        }
                    </select>
                </div>
                <div class="col-auto flex-grow-1">
                    <input type="text" name="search" value="@search" class="form-control rounded-pill"
                           placeholder="Tìm theo tên bệnh nhân hoặc dịch vụ..." style="max-width: 320px;" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted bg-light rounded-3">
                    <i class="fa-solid fa-vial-circle-check fa-3x mb-3 text-secondary"></i>
                    <p class="mb-0 fw-bold">Không có xét nghiệm nào @(statusFilter == "Pending" ? "đang chờ xử lý" : "đã hoàn thành").</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th style="width: 36px;"></th>
                                <th>Bệnh nhân</th>
                                <th>Bác sĩ chỉ định</th>
                                <th>Ngày chỉ định</th>
                                <th>Số xét nghiệm</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var appointmentGroups = Model
                                    .GroupBy(t => t.AppointmentId)
                                    .Select(g => new
                                    {
                                        AppointmentId = g.Key,
                                        Tests = g.OrderBy(t => t.ServiceName).ToList(),
                                        PatientName = g.First().PatientName,
                                        DoctorName = g.First().DoctorName,
                                        CreatedAt = g.Min(t => t.CreatedAt)
                                    })
                                    .OrderByDescending(g => g.CreatedAt)
                                    .ToList();
                            }
                            @foreach (var group in appointmentGroups)
                            {
                                <tr class="lab-group-toggle" data-bs-toggle="collapse" data-bs-target="#labGroupDetails-@group.AppointmentId" style="cursor: pointer;">
                                    <td class="text-center text-muted">
                                        <i class="fa-solid fa-chevron-right chevron-icon"></i>
                                    </td>
                                    <td class="fw-bold text-dark">@group.PatientName</td>
                                    <td class="small">@(string.IsNullOrEmpty(group.DoctorName) ? "—" : group.DoctorName)</td>
                                    <td class="small">@group.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-1">@group.Tests.Count xét nghiệm</span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fa-solid fa-list-ul me-1"></i> Xem chi tiết
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="p-0 border-0">
                                        <div class="collapse" id="labGroupDetails-@group.AppointmentId">
                                            <div class="bg-light rounded-3 p-3 m-2">
                                                <table class="table table-sm align-middle mb-0 bg-white rounded-3 overflow-hidden">
                                                    <thead>
                                                        <tr class="text-muted small">
                                                            <th>Dịch vụ xét nghiệm</th>
                                                            @if (statusFilter == "Completed")
                                                            {
                                                                <th>Ngày thực hiện</th>
                                                                <th>Kết quả</th>
                                                            }
                                                            <th class="text-end">Hành động</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var test in group.Tests)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-1">@test.ServiceName</span>
                                                                </td>
                                                                @if (statusFilter == "Completed")
                                                                {
                                                                    <td class="small">@(test.TestDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                                                    <td class="small text-wrap" style="max-width: 280px;">
                                                                        @if (test.Indicators.Any())
                                                                        {
                                                                            <ul class="list-unstyled mb-0">
                                                                                @foreach (var ind in test.Indicators)
                                                                                {
                                                                                    <li><span class="text-muted">@ind.Label:</span> <strong>@(string.IsNullOrEmpty(ind.Value) ? "—" : ind.Value)</strong> @ind.Unit</li>
                                                                                }
                                                                            </ul>
                                                                            @if (!string.IsNullOrEmpty(test.Result))
                                                                            {
                                                                                <div class="text-muted small mt-1">@test.Result</div>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            @(string.IsNullOrEmpty(test.Result) ? "—" : test.Result)
                                                                        }
                                                                    </td>
                                                                }
                                                                <td class="text-end">
                                                                    @if (statusFilter == "Pending")
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3"
                                                                                data-bs-toggle="modal" data-bs-target="#resultModal-@test.AppointmentLabTestId">
                                                                            <i class="fa-solid fa-pen-to-square me-1"></i> Nhập kết quả
                                                                        </button>

                                <div class="modal fade" id="resultModal-@test.AppointmentLabTestId" tabindex="-1" aria-hidden="true" dir="ltr">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content border-0 shadow-lg rounded-4 text-start">
                                                                                    <div class="modal-header bg-primary text-white rounded-top-4">
                                                                                        <h5 class="modal-title"><i class="fa-solid fa-flask me-2"></i>Nhập kết quả xét nghiệm</h5>
                                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                                                    </div>
                                                                                    <form asp-action="UpdateResult" method="post">
                                                                                        @Html.AntiForgeryToken()
                                                                                        <input type="hidden" name="id" value="@test.AppointmentLabTestId" />
                                                                                        <div class="modal-body p-4">
                                                                                            <div class="alert alert-info rounded-3 small">
                                                                                                <i class="fa-solid fa-circle-info me-2"></i>
                                                                                                Bệnh nhân: <strong>@test.PatientName</strong> &mdash; Dịch vụ: <strong>@test.ServiceName</strong>
                                                                                            </div>
                                                                                            <div class="mb-3">
                                                                                                <label class="form-label fw-bold small text-muted">Ngày thực hiện xét nghiệm</label>
                                                                                                <input type="datetime-local" name="testDate" class="form-control rounded-3" required
                                                                                                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                                                                            </div>
                                                                                            @if (test.Indicators.Any())
                                                                                            {
                                                                                                <label class="form-label fw-bold small text-muted mb-2">Chỉ số xét nghiệm (@test.ServiceName)</label>
                                                                                                <div class="row g-3 mb-3">
                                                                                                    @foreach (var ind in test.Indicators)
                                                                                                    {
                                                                                                        <div class="col-md-6">
                                                                                                            <label class="form-label small mb-1">
                                                                                                                @ind.Label
                                                                                                                @if (!string.IsNullOrEmpty(ind.Unit))
                                                                                                                {
                                                                                                                    <span class="text-muted">(@ind.Unit)</span>
                                                                                                                }
                                                                                                            </label>
                                                                                                            <input type="text" name="indicatorValues[@ind.Key]" class="form-control rounded-3"
                                                                                                                   placeholder="@(ind.NormalRange != null ? "Bình thường: " + ind.NormalRange : "")" />
                                                                                                        </div>
                                                                                                    }
                                                                                                </div>
                                                                                                <div class="mb-3">
                                                                                                    <label class="form-label fw-bold small text-muted">Kết luận / Ghi chú kết quả (không bắt buộc)</label>
                                                                                                    <textarea name="result" class="form-control rounded-3" rows="2"
                                                                                                              placeholder="Nhận định chung về kết quả (nếu cần)..."></textarea>
                                                                                                </div>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <div class="mb-3">
                                                                                                    <label class="form-label fw-bold small text-muted">Kết quả xét nghiệm</label>
                                                                                                    <textarea name="result" class="form-control rounded-3" rows="4" required
                                                                                                              placeholder="Nhập kết quả xét nghiệm..."></textarea>
                                                                                                </div>
                                                                                            }
                                                                                            <div class="mb-3">
                                                                                                <label class="form-label fw-bold small text-muted">Ghi chú (nếu có)</label>
                                                                                                <textarea name="notes" class="form-control rounded-3" rows="2"
                                                                                                          placeholder="Ghi chú thêm cho bác sĩ..."></textarea>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="modal-footer border-0 pt-0">
                                                                                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                                                                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                                                                                <i class="fa-solid fa-check me-1"></i> Lưu kết quả
                                                                                            </button>
                                                                                        </div>
                                                                                    </form>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success border rounded-pill px-3 py-1">Hoàn thành</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <style>
.modal[dir="ltr"] .form-control,
.modal[dir="ltr"] .form-select,
.modal[dir="ltr"] .form-label {
    text-align: left;
}
                                    .lab-group-toggle .chevron-icon {
                                        transition: transform 0.2s ease;
                                    }
                    .lab-group-toggle[aria-expanded="true"] .chevron-icon {
                        transform: rotate(90deg);
                    }
                    .lab-group-toggle:hover {
                        background-color: rgba(13, 110, 253, 0.04);
                    }
                </style>
            }
        </div>
    </div>
</div>
