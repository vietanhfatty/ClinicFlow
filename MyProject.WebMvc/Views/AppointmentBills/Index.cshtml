@model IEnumerable<MyProject.Application.DTOs.AppointmentBillDto>

@{
    ViewData["Title"] = "Quản lý Bill";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Quản lý Bill
            </h3>
            <p class="text-muted small mb-0">Xem và quản lý hóa đơn thanh toán cho các lịch hẹn</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success shadow-sm rounded-pill px-4">
                <i class="fa-solid fa-plus-circle me-1"></i> Tạo Bill
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Tìm bệnh nhân</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa-solid fa-user text-muted"></i>
                        </span>
                        <input type="text" name="searchPatient" class="form-control border-start-0" 
                               placeholder="Nhập tên bệnh nhân..." value="@ViewBag.SearchPatient" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Lọc theo trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="Pending" selected="@(ViewBag.Status == "Pending")">Chờ thanh toán</option>
                        <option value="Paid" selected="@(ViewBag.Status == "Paid")">Đã thanh toán</option>
                        <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">
                        <i class="fa-solid fa-filter me-1"></i> Lọc
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill">
                        <i class="fa-solid fa-rotate-left me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bills Table -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-success">Danh sách Bill (@Model.Count() bản ghi)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase font-monospace fs-7">
                        <tr>
                            <th class="ps-4">Bệnh nhân</th>
                            <th>Thông tin lịch hẹn</th>
                            <th>Phí khám</th>
                            <th>Phí xét nghiệm</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-receipt fa-3x mb-3 text-secondary"></i>
                                    <p class="mb-0 fw-bold">Chưa có bill nào.</p>
                                    <p class="small text-muted mb-0">Tạo bill mới cho bệnh nhân sau khi khám xong.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var bill in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">@bill.PatientName</span>
                                </td>
                                <td>
                                    <span class="small">@bill.AppointmentInfo</span>
                                </td>
                                <td class="fw-bold">@bill.ExaminationFee.ToString("N0") VND</td>
                                <td class="fw-bold">@bill.LabTestFee.ToString("N0") VND</td>
                                <td class="fw-bold text-success">@bill.TotalAmount.ToString("N0") VND</td>
                                <td>
                                    @if (bill.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">Chờ thanh toán</span>
                                    }
                                    else if (bill.Status == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2">@bill.Status</span>
                                    }
                                </td>
                                <td class="pe-4">
                                    <a asp-action="Details" asp-route-id="@bill.BillId" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="fa-solid fa-eye me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
