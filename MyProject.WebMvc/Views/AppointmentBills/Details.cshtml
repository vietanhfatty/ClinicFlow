@model MyProject.Application.DTOs.AppointmentBillDto

@{
    ViewData["Title"] = "Chi tiết Bill";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-success">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>Chi tiết Bill
                    </h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">MÃ BILL</div>
                        <div class="col-sm-8 text-dark fw-bold">#@Model.BillId</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">BỆNH NHÂN</div>
                        <div class="col-sm-8 text-dark fw-bold">@Model.PatientName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">LỊCH HẸN</div>
                        <div class="col-sm-8 text-dark">@Model.AppointmentInfo</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">PHÍ KHÁM</div>
                        <div class="col-sm-8 text-dark">@Model.ExaminationFee.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">PHÍ XÉT NGHIỆM</div>
                        <div class="col-sm-8 text-dark">@Model.LabTestFee.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">TỔNG TIỀN</div>
                        <div class="col-sm-8 text-dark fw-bold fs-5 text-success">@Model.TotalAmount.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">TRẠNG THÁI</div>
                        <div class="col-sm-8">
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Chờ thanh toán</span>
                            }
                            else if (Model.Status == "Paid")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">@Model.Status</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">NGÀY TẠO</div>
                        <div class="col-sm-8 text-dark">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                    </div>
                    @if (Model.PaidAt.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted small fw-bold">NGÀY THANH TOÁN</div>
                            <div class="col-sm-8 text-dark">@Model.PaidAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted small fw-bold">GHI CHÚ</div>
                            <div class="col-sm-8 text-dark">@Model.Notes</div>
                        </div>
                    }

                    <!-- Lab Tests Breakdown -->
                    @if (Model.LabTests != null && Model.LabTests.Any())
                    {
                        <div class="alert alert-light border rounded-3 mb-4">
                            <h6 class="fw-bold text-muted mb-3">
                                <i class="fa-solid fa-flask me-2"></i>Chi tiết xét nghiệm
                            </h6>
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr class="text-muted small">
                                        <th>Dịch vụ</th>
                                        <th class="text-end">Giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lt in Model.LabTests)
                                    {
                                        <tr>
                                            <td>@lt.ServiceName</td>
                                            <td class="text-end">@lt.Price.ToString("N0") VND</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex justify-content-start mt-4 gap-2">
                        @if (Model.Status == "Pending")
                        {
                            <form asp-action="MarkAsPaid" asp-route-id="@Model.BillId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success rounded-pill px-4">
                                    <i class="fa-solid fa-check-circle me-1"></i> Xác nhận thanh toán
                                </button>
                            </form>
                            <form asp-action="Cancel" asp-route-id="@Model.BillId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger rounded-pill px-4" 
                                        onclick="return confirm('Bạn có chắc muốn hủy bill này?');">
                                    <i class="fa-solid fa-times-circle me-1"></i> Hủy bill
                                </button>
                            </form>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
