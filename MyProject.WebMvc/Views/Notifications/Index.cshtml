@model IEnumerable<MyProject.Application.DTOs.NotificationDto>

@{
    ViewData["Title"] = "Notifications";
    var notifications = Model?.OrderByDescending(n => n.CreatedAt).ToList()
        ?? new List<MyProject.Application.DTOs.NotificationDto>();
    var unreadCount = notifications.Count(n => !n.IsRead);

    string TimeAgo(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("MMM dd, yyyy");
    }

    string IconFor(string type) => type switch
    {
        "Appointment" => "fa-calendar-check",
        "LabTest" => "fa-flask",
        "MedicalRecord" => "fa-file-medical",
        "Prescription" => "fa-prescription-bottle-medical",
        "Payment" => "fa-credit-card",
        _ => "fa-bell"
    };

    string IconColorFor(string type) => type switch
    {
        "Appointment" => "text-info",
        "LabTest" => "text-warning",
        "MedicalRecord" => "text-primary",
        "Prescription" => "text-success",
        "Payment" => "text-danger",
        _ => "text-secondary"
    };
}

<div class="notifications-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="fa-regular fa-bell text-primary me-2"></i>Notifications
            </h1>
            <p class="text-muted mb-0">
                @(unreadCount > 0 ? $"You have {unreadCount} unread notification(s)" : "You're all caught up")
            </p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="m-0">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="fa-solid fa-check-double me-1"></i>Mark all as read
                </button>
            </form>
        }
    </div>

    @if (!notifications.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <div class="mb-3" style="font-size: 3rem; color: #d1d5db;">
                    <i class="fa-regular fa-bell-slash"></i>
                </div>
                <h5 class="fw-semibold text-muted mb-1">No notifications yet</h5>
                <p class="text-muted small mb-0">We'll let you know when something needs your attention.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="list-group list-group-flush">
                @foreach (var n in notifications)
                {
                    <div class="list-group-item d-flex gap-3 px-4 py-3 notif-row @(n.IsRead ? "" : "unread")">
                        <div class="notif-icon @IconColorFor(n.Type)">
                            <i class="fa-solid @IconFor(n.Type)"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="fw-semibold text-dark">@n.Title</span>
                                <small class="text-muted ms-2 flex-shrink-0">@TimeAgo(n.CreatedAt)</small>
                            </div>
                            <p class="text-muted small mb-0 mt-1">@n.Message</p>
                        </div>
                        @if (!n.IsRead)
                        {
                            <span class="notif-dot"></span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .notif-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(0,0,0,0.04);
        font-size: 1.1rem;
    }

    .notif-row {
        transition: background 0.15s ease;
    }

    .notif-row.unread {
        background: #eef2ff;
    }

    .notif-row:hover {
        background: #f8f9ff;
    }

    .notif-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #4f46e5;
        align-self: center;
        flex-shrink: 0;
    }
</style>
