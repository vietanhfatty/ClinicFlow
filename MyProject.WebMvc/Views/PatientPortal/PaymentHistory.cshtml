@model IEnumerable<MyProject.Application.DTOs.PaymentDto>

@{
    ViewData["Title"] = "My Payments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="fa-solid fa-credit-card text-success me-2"></i>My Payments</h1>
            <p class="text-muted small mb-0">Track payment requests for lab tests and services, and settle outstanding balances.</p>
        </div>
        <div>
            <a asp-action="RequestPayment" class="btn btn-success rounded-pill px-4">
                <i class="fa-solid fa-plus me-1"></i> Request Payment
            </a>
        </div>
    </div>

    <!-- Payments list -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-success">Payment Records (@Model.Count() records)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase font-monospace fs-7">
                        <tr>
                            <th class="ps-4">Appointment</th>
                            <th>Reason</th>
                            <th>Amount</th>
                            <th>Requested On</th>
                            <th>Paid On</th>
                            <th class="pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-receipt fa-3x mb-3 text-secondary"></i>
                                    <p class="mb-0 fw-bold">No payment requests yet.</p>
                                    <p class="small text-muted mb-0">Request a payment for completed lab tests using the button above.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var payment in Model.OrderByDescending(p => p.RequestDate))
                        {
                            <tr data-bs-toggle="collapse" data-bs-target="#payment-details-@payment.PaymentId" style="cursor:pointer;">
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(payment.AppointmentInfo))
                                    {
                                        <span class="small text-dark">@payment.AppointmentInfo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@payment.Reason</span>
                                    @if (payment.LabTests != null && payment.LabTests.Any())
                                    {
                                        <button class="btn btn-link btn-sm p-0 ms-2 text-success" type="button" onclick="event.stopPropagation();">
                                            <i class="fa-solid fa-chevron-down small"></i> @payment.LabTests.Count items
                                        </button>
                                    }
                                </td>
                                <td class="fw-bold text-success">@payment.Amount.ToString("C")</td>
                                <td class="small">@payment.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small">@(payment.PaidDate.HasValue ? payment.PaidDate.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                <td class="pe-4">
                                    @if (payment.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">Pending</span>
                                    }
                                    else if (payment.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2">@payment.Status</span>
                                    }
                                </td>
                            </tr>
                            @if (payment.LabTests != null && payment.LabTests.Any())
                            {
                                <tr class="collapse" id="payment-details-@payment.PaymentId">
                                    <td colspan="6" class="bg-light px-5 py-3 border-0">
                                        <div class="small">
                                            <div class="fw-bold text-muted mb-2 text-uppercase" style="font-size:0.7rem;">Lab Tests Breakdown</div>
                                            <table class="table table-sm table-borderless mb-0">
                                                <thead>
                                                    <tr class="text-muted small">
                                                        <th>Service</th>
                                                        <th class="text-end">Price</th>
                                                        <th class="text-center">Date</th>
                                                        <th class="text-center">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var lt in payment.LabTests)
                                                    {
                                                        <tr class="border-bottom border-light">
                                                            <td>@lt.ServiceName</td>
                                                            <td class="text-end">@lt.Price.ToString("C")</td>
                                                            <td class="text-center">@(lt.TestDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                                            <td class="text-center">
                                                                <span class="badge bg-success-subtle text-success rounded-pill px-2">@lt.Status</span>
                                                            </td>
                                                        </tr>
                                                    }
                                                    <tr class="fw-bold text-dark">
                                                        <td>Total</td>
                                                        <td class="text-end">@payment.LabTests.Sum(l => l.Price).ToString("C")</td>
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
