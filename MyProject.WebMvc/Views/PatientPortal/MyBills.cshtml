@model IEnumerable<MyProject.Application.DTOs.AppointmentBillDto>

@{
    ViewData["Title"] = "My Bills";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>My Bills
            </h1>
            <p class="text-muted small mb-0">View your appointment bills and payment history.</p>
        </div>
    </div>

    <!-- Bills list -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-success">Bill History (@Model.Count() records)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase font-monospace fs-7">
                        <tr>
                            <th class="ps-4">Appointment</th>
                            <th>Examination Fee</th>
                            <th>Lab Test Fee</th>
                            <th>Total</th>
                            <th>Created</th>
                            <th class="pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-receipt fa-3x mb-3 text-secondary"></i>
                                    <p class="mb-0 fw-bold">No bills yet.</p>
                                    <p class="small text-muted mb-0">Your bills will appear here after your appointments.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var bill in Model.OrderByDescending(b => b.CreatedAt))
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="small text-dark">@bill.AppointmentInfo</span>
                                </td>
                                <td>@bill.ExaminationFee.ToString("N0") VND</td>
                                <td>@bill.LabTestFee.ToString("N0") VND</td>
                                <td class="fw-bold text-success">@bill.TotalAmount.ToString("N0") VND</td>
                                <td class="small">@bill.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="pe-4">
                                    @if (bill.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">Pending</span>
                                    }
                                    else if (bill.Status == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2">@bill.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
