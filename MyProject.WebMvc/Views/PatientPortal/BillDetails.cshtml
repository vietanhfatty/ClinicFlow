@model MyProject.Application.DTOs.AppointmentBillDto

@{
    ViewData["Title"] = "Bill Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-success">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>Bill Details
                    </h5>
                    <a asp-action="MyBills" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">BILL ID</div>
                        <div class="col-sm-8 text-dark fw-bold">#@Model.BillId</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">APPOINTMENT</div>
                        <div class="col-sm-8 text-dark">@Model.AppointmentInfo</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">EXAMINATION FEE</div>
                        <div class="col-sm-8 text-dark">@Model.ExaminationFee.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">LAB TEST FEE</div>
                        <div class="col-sm-8 text-dark">@Model.LabTestFee.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">TOTAL</div>
                        <div class="col-sm-8 text-dark fw-bold fs-5 text-success">@Model.TotalAmount.ToString("N0") VND</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">STATUS</div>
                        <div class="col-sm-8">
                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Pending Payment</span>
                            }
                            else if (Model.Status == "Paid")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">@Model.Status</span>
                            }
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted small fw-bold">CREATED</div>
                        <div class="col-sm-8 text-dark">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                    </div>
                    @if (Model.PaidAt.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted small fw-bold">PAID ON</div>
                            <div class="col-sm-8 text-dark">@Model.PaidAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</div>
                        </div>
                    }

                    @if (Model.Status == "Pending")
                    {
                        <div class="alert alert-warning rounded-3 mt-3">
                            <i class="fa-solid fa-exclamation-circle me-2"></i>
                            <strong>Payment Required:</strong> Please contact the reception to complete your payment.
                        </div>
                    }

                    @if (Model.Status == "Paid")
                    {
                        <div class="alert alert-success rounded-3 mt-3">
                            <i class="fa-solid fa-check-circle me-2"></i>
                            <strong>Payment Completed.</strong> Thank you for your payment.
                        </div>
                    }

                    <div class="d-flex justify-content-start mt-4">
                        <a asp-action="MyBills" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to My Bills
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
