@model MyProject.Application.DTOs.MedicalRecordDto

@{
    ViewData["Title"] = "Medical Record Details";
}

<div class="container mt-4">
    <!-- Back Navigation -->
    <div class="mb-4">
        <a asp-controller="PatientPortal" asp-action="MyMedicalRecords" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to My Records
        </a>
    </div>

    <!-- Header -->
    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex flex-wrap gap-3 mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary rounded-pill px-3">
                        <i class="fa-solid fa-calendar me-1"></i> @Model.AppointmentDate.ToString("yyyy-MM-dd") at @Model.AppointmentTime.ToString(@"hh\:mm")
                    </span>
                    <span class="badge @(Model.AppointmentStatus == "Completed" ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning border border-warning") rounded-pill px-3">
                        <i class="fa-solid fa-circle-info me-1"></i> @Model.AppointmentStatus
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-0">Hồ Sơ Bệnh Án</h2>
                <p class="text-muted small mb-0">Created on @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button class="btn btn-outline-primary rounded-pill px-4" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> Print Record
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main content -->
        <div class="col-lg-8">

            <!-- appointment Info -->
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-calendar-check text-primary me-2"></i>Appointment Information
                </h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="bg-light rounded-3 p-3 text-center">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Date</div>
                            <div class="fw-bold text-dark">@Model.AppointmentDate.ToString("yyyy-MM-dd")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-light rounded-3 p-3 text-center">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Time</div>
                            <div class="fw-bold text-dark">@Model.AppointmentTime.ToString(@"hh\:mm")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-light rounded-3 p-3 text-center">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Status</div>
                            <div class="fw-bold @(Model.AppointmentStatus == "Completed" ? "text-success" : "text-warning")">@Model.AppointmentStatus</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clinical Assessment -->
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-stethoscope text-primary me-2"></i>Clinical Assessment
                </h5>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted small text-uppercase">Symptoms (Triệu chứng)</h6>
                    <p class="text-dark bg-light p-3 rounded-3 border-start border-primary border-3 mb-0">
                        @(string.IsNullOrEmpty(Model.Symptoms) ? "No symptoms recorded." : Model.Symptoms)
                    </p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted small text-uppercase">Diagnosis (Chẩn đoán)</h6>
                    <p class="text-dark bg-light p-3 rounded-3 border-start border-danger border-3 fw-bold mb-0">
                        @(string.IsNullOrEmpty(Model.Diagnosis) ? "No diagnosis recorded." : Model.Diagnosis)
                    </p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted small text-uppercase">Treatment (Phương án điều trị)</h6>
                    <p class="text-dark bg-light p-3 rounded-3 border-start border-success border-3 mb-0">
                        @(string.IsNullOrEmpty(Model.Treatment) ? "No treatment plan recorded." : Model.Treatment)
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mb-0">
                        <h6 class="fw-bold text-muted small text-uppercase">Notes (Ghi chú)</h6>
                        <p class="text-dark bg-light p-3 rounded-3 mb-0">@Model.Notes</p>
                    </div>
                }
            </div>

            <!-- Lab Tests -->
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-flask-vial text-info me-2"></i>Lab Tests (Xét nghiệm)
                </h5>

                @if (Model.LabTests == null || !Model.LabTests.Any())
                {
                    <div class="text-center py-4 text-muted bg-light rounded-3">
                        <i class="fa-solid fa-flask fa-2x mb-2 text-secondary"></i>
                        <p class="mb-0 small fw-bold">No lab tests ordered for this appointment.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Service</th>
                                    <th class="text-end">Price</th>
                                    <th>Test Date</th>
                                    <th>Status</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lt in Model.LabTests)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@lt.ServiceName</td>
                                        <td class="text-end text-success fw-bold">@lt.Price.ToString("N0") VND</td>
                                        <td class="small">@(lt.TestDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            @if (lt.Status == "Completed")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2">Completed</span>
                                            }
                                            else if (lt.Status == "Pending")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-2">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary rounded-pill px-2">@lt.Status</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@(string.IsNullOrEmpty(lt.Result) ? "—" : lt.Result)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold border-top">
                                    <td>Total</td>
                                    <td class="text-end text-success">@Model.LabTests.Sum(l => l.Price).ToString("N0") VND</td>
                                    <td colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

            <!-- Prescriptions -->
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-file-prescription text-danger me-2"></i>Prescriptions (Đơn thuốc)
                </h5>

                @if (Model.Prescriptions == null || !Model.Prescriptions.Any())
                {
                    <div class="text-center py-4 text-muted bg-light rounded-3">
                        <i class="fa-solid fa-pills fa-2x mb-2 text-secondary"></i>
                        <p class="mb-0 small fw-bold">No medicines prescribed in this session.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicine</th>
                                    <th>Dosage</th>
                                    <th class="text-center">Quantity</th>
                                    <th>Instructions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prep in Model.Prescriptions)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@prep.MedicineName</td>
                                        <td><span class="badge bg-primary-subtle text-primary rounded-pill px-2">@prep.Dosage</span></td>
                                        <td class="text-center"><span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">@prep.Quantity</span></td>
                                        <td class="small text-muted">@prep.Instruction</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fa-solid fa-id-card text-success me-2"></i>Parties Involved
                </h5>

                <!-- Patient -->
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-success-subtle text-success rounded-circle p-3 me-3">
                        <i class="fa-solid fa-user-injured fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-bold mb-0">Patient</div>
                        <div class="fw-bold text-dark">@Model.PatientName</div>
                    </div>
                </div>

                <!-- doctor -->
                <div class="d-flex align-items-center">
                    <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3">
                        <i class="fa-solid fa-user-md fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-bold mb-0">Attending Physician</div>
                        <div class="fw-bold text-dark">@Model.DoctorName</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 bg-primary text-white p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-shield-halved me-2"></i>Confidentiality</h5>
                <p class="small mb-0 text-white-50">
                    This file is protected under healthcare confidentiality regulations. Access is tracked and authorized to medical personnel and the patient only.
                </p>
            </div>
        </div>
    </div>
</div>
