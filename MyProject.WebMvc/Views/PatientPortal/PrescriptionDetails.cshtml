@model MyProject.Application.DTOs.PrescriptionDetailDto

@{
    ViewData["Title"] = "Prescription Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Central Hospital</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: #f4f6f9;
        }
        .rx-sheet {
            max-width: 720px;
            margin: 40px auto;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
        }
        .rx-header {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: #fff;
            padding: 28px 36px;
        }
        .rx-header h2 { font-weight: 700; margin-bottom: 2px; }
        .rx-header .sub { opacity: 0.85; font-size: 0.9rem; }
        .rx-body { padding: 36px; }
        .rx-meta-row { display: flex; justify-content: space-between; border-bottom: 1px dashed #dee2e6; padding-bottom: 16px; margin-bottom: 24px; }
        .rx-meta-label { font-size: 0.75rem; text-transform: uppercase; color: #6c757d; letter-spacing: .03em; }
        .rx-meta-value { font-weight: 600; color: #212529; }
        .rx-medicine-card {
            border: 2px solid #0d6efd;
            border-radius: 14px;
            padding: 24px;
            background: #f0f7ff;
        }
        .rx-medicine-card h3 { color: #0a58ca; font-weight: 700; }
        .rx-field { margin-bottom: 12px; }
        .rx-field-label { font-size: 0.8rem; color: #6c757d; font-weight: 600; }
        .rx-actions { padding: 0 36px 32px; display: flex; gap: 10px; }
        .rx-footer { text-align: center; padding: 16px; color: #adb5bd; font-size: 0.75rem; }
        @@media print {
            body { background: #fff; }
            .no-print { display: none !important; }
            .rx-sheet { box-shadow: none; margin: 0; border-radius: 0; max-width: 100%; }
        }
    </style>
</head>
<body>
    <div class="rx-sheet">
        <div class="rx-header d-flex justify-content-between align-items-center">
            <div>
                <h2><i class="fa-solid fa-file-prescription me-2"></i>Đơn thuốc / Prescription</h2>
                <div class="sub">Central Hospital - Hospital Management System</div>
            </div>
            <div class="text-end">
                <div class="sub">Mã đơn thuốc</div>
                <div class="fw-bold fs-5">#@Model.PrescriptionId.ToString("D6")</div>
            </div>
        </div>

        <div class="rx-body">
            <div class="rx-meta-row">
                <div>
                    <div class="rx-meta-label">Bệnh nhân / Patient</div>
                    <div class="rx-meta-value">@Model.PatientName</div>
                </div>
                <div>
                    <div class="rx-meta-label">Bác sĩ kê đơn / Doctor</div>
                    <div class="rx-meta-value">@Model.DoctorName</div>
                </div>
                <div class="text-end">
                    <div class="rx-meta-label">Ngày kê đơn / Date</div>
                    <div class="rx-meta-value">@Model.PrescribedDate.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
            {
                <div class="mb-4">
                    <div class="rx-field-label">Chẩn đoán / Diagnosis</div>
                    <div class="fw-semibold">@Model.Diagnosis</div>
                </div>
            }

            <div class="rx-medicine-card">
                <h3><i class="fa-solid fa-pills me-2"></i>@Model.MedicineName</h3>
                <div class="row mt-3">
                    <div class="col-md-6 rx-field">
                        <div class="rx-field-label">Liều dùng / Dosage</div>
                        <div class="fs-5">@(Model.Dosage ?? "Theo chỉ dẫn của bác sĩ")</div>
                    </div>
                    <div class="col-md-6 rx-field">
                        <div class="rx-field-label">Số lượng / Quantity</div>
                        <div class="fs-5">@(Model.Quantity?.ToString() ?? "N/A")</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Instruction))
                {
                    <div class="rx-field mb-0">
                        <div class="rx-field-label">Hướng dẫn sử dụng / Instructions</div>
                        <div>@Model.Instruction</div>
                    </div>
                }
            </div>
        </div>

        <div class="rx-actions no-print">
            <a asp-action="MyMedicalRecords" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
            </a>
            <button type="button" class="btn btn-primary rounded-pill px-4" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> In đơn thuốc
            </button>
        </div>

        <div class="rx-footer">
            Tài liệu này được tạo tự động từ hệ thống Central Hospital Management System.
        </div>
    </div>
</body>
</html>
