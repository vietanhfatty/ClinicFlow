@{
    ViewData["Title"] = "Request Payment";
    var appointments = ViewBag.CompletedAppointments as List<MyProject.Application.DTOs.AppointmentDto> ?? new List<MyProject.Application.DTOs.AppointmentDto>();
}

<div class="container mt-4">
    <div class="mb-4">
        <a asp-action="PaymentHistory" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Payments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <h3 class="fw-bold text-dark mb-2"><i class="fa-solid fa-credit-card text-success me-2"></i>Request Payment</h3>
                <p class="text-muted small border-bottom pb-3 mb-4">Select a completed appointment with lab tests to pay for, then submit your request. Amount will be auto-calculated from lab test prices.</p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-4" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
                    </div>
                }

                @if (!appointments.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-calendar-check fa-3x mb-3 text-secondary"></i>
                        <p class="mb-0 fw-bold">No completed appointments with lab tests found.</p>
                        <p class="small text-muted mb-0">Once your appointments are completed and lab tests are done, they will appear here for payment.</p>
                    </div>
                }
                else
                {
                    <form asp-action="RequestPayment" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small mb-2">Select Appointment *</label>
                            <div class="list-group">
                                @foreach (var apt in appointments)
                                {
                                    <label class="list-group-item d-flex align-items-center gap-3 rounded-3 mb-2 border">
                                        <input class="form-check-input flex-shrink-0" type="radio" name="AppointmentId" value="@apt.AppointmentId" required />
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark">@apt.AppointmentDate.ToString("yyyy-MM-dd") at @apt.AppointmentTime.ToString(@"hh\:mm")</div>
                                            <div class="small text-muted">Doctor: @(apt.DoctorName ?? "N/A") &middot; Reason: @(apt.Reason ?? "N/A")</div>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="Reason" class="form-label fw-bold text-muted small">Note (optional)</label>
                            <textarea id="Reason" name="Reason" class="form-control rounded-3" rows="2" placeholder="Leave blank to auto-generate reason from lab test names..."></textarea>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success rounded-pill py-2 fw-bold">
                                Submit Payment Request <i class="fa-solid fa-paper-plane ms-2"></i>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
